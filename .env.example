# Copy to .env (or run ./scripts/setup.sh to create it). Never commit .env.
# Every value below is a placeholder; required values are left EMPTY so compose fails until they are filled in.

# ==========================================================================
# 1. Required for everyone
# ==========================================================================
# Bot token from the Discord Developer Portal (Bot tab).
DISCORD_TOKEN=
# Application ID (General Information tab).
DISCORD_CLIENT_ID=
# Optional: guild ID so slash commands take effect immediately during development. Empty = global registration only.
DEV_GUILD_ID=

# ==========================================================================
# 2. Docker stack secrets (generated by ./scripts/setup.sh; or: openssl rand -hex 24)
#    Use only [A-Za-z0-9_-] characters so DATABASE_URL / REDIS_URL need no escaping.
# ==========================================================================
LAVALINK_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ==========================================================================
# 3. Docker stack options (read by docker compose)
# ==========================================================================
# Empty = build the image from source. Set it (for example ghcr.io/<owner>/<repo>:1.2.0) to pull a prebuilt image.
BOT_IMAGE=
# JVM options for Lavalink (heap size).
LAVALINK_JAVA_OPTS=-Xmx1G
# Set to true and fill in the Spotify credentials below to enable Spotify links.
LAVASRC_SPOTIFY_ENABLED=false
# Spotify application client ID (Spotify developer dashboard).
SPOTIFY_CLIENT_ID=
# Spotify application client secret.
SPOTIFY_CLIENT_SECRET=
# Country code of the Spotify market.
SPOTIFY_COUNTRY_CODE=US
# Optional YouTube bot-check workarounds (uncomment the whole matching block in lavalink/application.yml).
# YOUTUBE_OAUTH_REFRESH_TOKEN=
# YOUTUBE_PO_TOKEN=
# YOUTUBE_VISITOR_DATA=
# What the bot does on startup inside the container (the defaults below are already the compose values).
# AUTO_MIGRATE=true
# REGISTER_COMMANDS_ON_START=true
# REGISTER_COMMANDS_FORCE=false
# Number of Postgres backups to keep (scripts/backup.sh).
BACKUP_KEEP=14

# ==========================================================================
# 4. Bot behavior (optional; compose passes these variables into the container)
# ==========================================================================
# Log level: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
# Human-readable logs (pino-pretty) instead of JSON.
LOG_PRETTY=false
# Prefix of every Redis key (lowercase letters, digits, - and _; at most 32 characters). Final key: <prefix>:v1:...
REDIS_KEY_PREFIX=perry
# Rejoin the voice channel and resume the queue after a restart.
PLAYER_RESTORE=true
# Store every played track (with the requester id) in PostgreSQL.
PLAY_HISTORY=false
# Share settings invalidation between multiple bot processes through Redis pub/sub.
PUBSUB_INVALIDATION=false
# Default bot language for servers that have not chosen one with /settings language: en (English) or vi (Vietnamese). Empty = en.
DEFAULT_LOCALE=en
# --- Music discovery (autoplay, /radio, /similar) ---
# Providers are tried in order until there are enough tracks: ytmix (YouTube Mix), lastfm, lavasrc, artist.
# lastfm needs LASTFM_API_KEY and lavasrc needs DISCOVERY_LAVASRC_PREFIX, otherwise they are skipped.
DISCOVERY_PROVIDERS=ytmix,lastfm,lavasrc,artist
# Free Last.fm API key: https://www.last.fm/api/account/create (empty = lastfm provider disabled).
LASTFM_API_KEY=
# LavaSrc recommendation prefix: dzrec (Deezer), ymrec (Yandex Music), vkrec (VK Music) or qbrec (Qobuz). Empty = disabled.
# The matching LavaSrc source must be enabled with credentials in lavalink/application.yml.
# Do not enable Deezer without a master key: Lavalink will fail to start.
# Spotify recommendations are not supported: Spotify no longer offers them to new applications.
DISCOVERY_LAVASRC_PREFIX=
# Skip recommended tracks outside this duration range (seconds).
DISCOVERY_MIN_DURATION_SEC=60
DISCOVERY_MAX_DURATION_SEC=1200

# ==========================================================================
# 5. ONLY for running the bot on the host (npm run dev / npm start) with docker-compose.dev.yml.
#    docker-compose.yml (production) IGNORES this group: it sets hosts/URLs by service name.
# ==========================================================================
# Lavalink on the host (port published on 127.0.0.1 by docker-compose.dev.yml).
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
# Only set to true when Lavalink is behind TLS.
LAVALINK_SECURE=false
# persistent = PostgreSQL + Redis (settings are kept); memory = everything in-process, nothing is saved.
STORAGE_DRIVER=persistent
# PostgreSQL connection string, required when STORAGE_DRIVER=persistent. Also used by `npm run db:migrate`.
# Format: postgres://perry:<POSTGRES_PASSWORD>@127.0.0.1:<POSTGRES_PORT>/perry
DATABASE_URL=
# Redis connection string, required when STORAGE_DRIVER=persistent.
# Format: redis://:<REDIS_PASSWORD>@127.0.0.1:<REDIS_PORT>
REDIS_URL=
# Host ports (bound to 127.0.0.1) of docker-compose.dev.yml. Change them if 5432 / 6379 are taken,
# and keep DATABASE_URL / REDIS_URL in sync.
POSTGRES_PORT=5432
REDIS_PORT=6379
# ==========================================================================
# 6. Web dashboard and landing page (optional, v1.4)
#    Enable with COMPOSE_PROFILES=web. Needs a public HTTPS address served by your reverse proxy.
# ==========================================================================
# Optional compose services to start. Set to web to run the dashboard.
COMPOSE_PROFILES=
# Public address of the dashboard without a trailing slash (https, except http://localhost for development).
# Add <PUBLIC_URL>/auth/callback under OAuth2 > Redirects in the Developer Portal.
PUBLIC_URL=
# OAuth2 client secret (Developer Portal > OAuth2 > Client Secret).
DISCORD_CLIENT_SECRET=
# Encrypts the Discord tokens kept in server-side sessions (generated by ./scripts/setup.sh, 64 hex characters).
SESSION_SECRET=
# Host port bound on 127.0.0.1 for your reverse proxy (the listen port when running the web on the host).
WEB_PORT=3000
# Proxy addresses whose X-Forwarded-For entries are skipped when finding the client IP (rate limits).
# Comma list of loopback, linklocal, uniquelocal, IP addresses or CIDRs. The default fits a reverse proxy on the same host.
WEB_TRUST_PROXY=loopback,uniquelocal
# Only for running the web on the host: listen address (the container always listens on 0.0.0.0).
WEB_HOST=127.0.0.1
