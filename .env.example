# Copy to .env (hoặc chạy ./scripts/setup.sh để tự tạo). Không bao giờ commit .env.
# Mọi giá trị bên dưới là placeholder; các giá trị bắt buộc để TRỐNG để compose báo lỗi khi chưa điền.

# ==========================================================================
# 1. Bắt buộc cho mọi người
# ==========================================================================
# Bot token từ Discord Developer Portal (tab Bot).
DISCORD_TOKEN=
# Application ID (tab General Information).
DISCORD_CLIENT_ID=
# Tùy chọn: guild ID để lệnh slash có hiệu lực ngay khi phát triển. Để trống = chỉ đăng ký toàn cầu.
DEV_GUILD_ID=

# ==========================================================================
# 2. Secret của Docker stack (./scripts/setup.sh tự sinh; hoặc: openssl rand -hex 24)
#    Chỉ dùng ký tự [A-Za-z0-9_-] để DATABASE_URL / REDIS_URL không cần escape.
# ==========================================================================
LAVALINK_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ==========================================================================
# 3. Tùy chọn của Docker stack (do docker compose đọc)
# ==========================================================================
# Để trống = build image từ mã nguồn. Đặt (ví dụ ghcr.io/<owner>/<repo>:1.2.0) để pull image dựng sẵn.
BOT_IMAGE=
# Tùy chọn JVM cho Lavalink (heap size).
LAVALINK_JAVA_OPTS=-Xmx1G
# Đặt true và điền thông tin Spotify bên dưới để bật liên kết Spotify.
LAVASRC_SPOTIFY_ENABLED=false
# Spotify application client ID (Spotify developer dashboard).
SPOTIFY_CLIENT_ID=
# Spotify application client secret.
SPOTIFY_CLIENT_SECRET=
# Mã quốc gia của thị trường Spotify.
SPOTIFY_COUNTRY_CODE=US
# Tùy chọn chống bot-check của YouTube (bỏ comment cả khối tương ứng trong lavalink/application.yml).
# YOUTUBE_OAUTH_REFRESH_TOKEN=
# YOUTUBE_PO_TOKEN=
# YOUTUBE_VISITOR_DATA=
# Việc bot làm khi khởi động trong container (mặc định bên dưới đã là giá trị của compose).
# AUTO_MIGRATE=true
# REGISTER_COMMANDS_ON_START=true
# REGISTER_COMMANDS_FORCE=false
# Số bản sao lưu Postgres giữ lại (scripts/backup.sh).
BACKUP_KEEP=14

# ==========================================================================
# 4. Hành vi của bot (tùy chọn; compose chuyển các biến này vào container)
# ==========================================================================
# Log level: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
# Log dễ đọc (pino-pretty) thay cho JSON.
LOG_PRETTY=false
# Tiền tố của mọi Redis key (chữ thường, số, - và _; tối đa 32 ký tự). Key cuối: <prefix>:v1:...
REDIS_KEY_PREFIX=perry
# Vào lại voice channel và tiếp tục queue sau khi restart.
PLAYER_RESTORE=true
# Lưu mọi bài đã phát (kèm id người yêu cầu) vào PostgreSQL.
PLAY_HISTORY=false
# Chia sẻ invalidation của settings giữa nhiều tiến trình bot qua Redis pub/sub.
PUBSUB_INVALIDATION=false
# --- Music discovery (autoplay, /radio, /similar) ---
# Provider thử theo thứ tự đến khi đủ bài: ytmix (YouTube Mix), lastfm, lavasrc, artist.
# lastfm cần LASTFM_API_KEY và lavasrc cần DISCOVERY_LAVASRC_PREFIX, nếu không sẽ bị bỏ qua.
DISCOVERY_PROVIDERS=ytmix,lastfm,lavasrc,artist
# Last.fm API key miễn phí: https://www.last.fm/api/account/create (để trống = tắt provider lastfm).
LASTFM_API_KEY=
# Prefix gợi ý của LavaSrc: dzrec (Deezer), ymrec (Yandex Music), vkrec (VK Music) hoặc qbrec (Qobuz). Để trống = tắt.
# Nguồn LavaSrc tương ứng phải được bật cùng credentials trong lavalink/application.yml.
# Không bật Deezer khi chưa có master key: Lavalink sẽ không khởi động được.
# Gợi ý của Spotify không được hỗ trợ: Spotify không còn cung cấp cho ứng dụng mới.
DISCOVERY_LAVASRC_PREFIX=
# Bỏ qua bài gợi ý nằm ngoài khoảng thời lượng này (giây).
DISCOVERY_MIN_DURATION_SEC=60
DISCOVERY_MAX_DURATION_SEC=1200

# ==========================================================================
# 5. CHỈ cho chạy bot trên máy host (npm run dev / npm start) cùng docker-compose.dev.yml.
#    docker-compose.yml (production) BỎ QUA nhóm này: nó tự đặt host/URL theo tên service.
# ==========================================================================
# Lavalink trên máy host (cổng publish ở 127.0.0.1 bởi docker-compose.dev.yml).
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
# Chỉ đặt true khi Lavalink nằm sau TLS.
LAVALINK_SECURE=false
# persistent = PostgreSQL + Redis (settings được giữ lại); memory = toàn bộ trong tiến trình, không lưu gì.
STORAGE_DRIVER=persistent
# Chuỗi kết nối PostgreSQL, bắt buộc khi STORAGE_DRIVER=persistent. Cũng được `npm run db:migrate` dùng.
# Dạng: postgres://perry:<POSTGRES_PASSWORD>@127.0.0.1:<POSTGRES_PORT>/perry
DATABASE_URL=
# Chuỗi kết nối Redis, bắt buộc khi STORAGE_DRIVER=persistent.
# Dạng: redis://:<REDIS_PASSWORD>@127.0.0.1:<REDIS_PORT>
REDIS_URL=
# Cổng host (bind 127.0.0.1) của docker-compose.dev.yml. Đổi nếu 5432 / 6379 đã bị dùng,
# và giữ DATABASE_URL / REDIS_URL đồng bộ.
POSTGRES_PORT=5432
REDIS_PORT=6379
